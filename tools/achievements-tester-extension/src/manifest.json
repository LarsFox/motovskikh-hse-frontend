{
  "manifest_version": 3,
  "name": "Motovskikh Achievements Tester",
  "version": "0.2.15",
  "description": "Test-only achievements overlay for motovskikh.ru",
  "permissions": ["storage"],
  "host_permissions": [
    "https://motovskikh.ru/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "options.html",
  "action": {"default_title": "Achievements settings"},
  "content_scripts": [
    {
      "matches": ["https://motovskikh.ru/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://motovskikh.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["js/achievements.js", "css/achievements.css", "assets/star.svg"],
    "matches": ["https://motovskikh.ru/*"]
  }]
}
